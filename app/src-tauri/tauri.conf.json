{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitschnitt",
  "version": "0.5.1",
  "identifier": "io.github.zweisteinium.mitschnitt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mitschnitt",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["mitschnitt"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zweisteinium",
    "copyright": "Copyright (C) 2026 Zweisteinium - GNU AGPL v3",
    "shortDescription": "Bit-exact recordings of what you play",
    "licenseFile": "../../LICENSE",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
